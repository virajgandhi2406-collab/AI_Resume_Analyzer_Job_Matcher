# ===============================================
# AI Resume Analyzer & Job Matcher - Environment
# ===============================================

# Server & Security
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=super-secret-key-change-in-production-ai-resume-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default is SQLite local file (sqlite:///app.db)
# For PostgreSQL: postgresql+psycopg2://username:password@localhost:5432/resumedb
DATABASE_URL=sqlite:///app.db

# AI Engine Providers (Optional - Local Smart NLP fallback works offline without any keys)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEFAULT_AI_PROVIDER=auto
